diff --git a/evidence/review/verify-cli.py b/evidence/review/verify-cli.py
new file mode 100644
index 000000000..95be34af1
--- /dev/null
+++ b/evidence/review/verify-cli.py
@@ -0,0 +1,43 @@
+import hashlib,json,os,pathlib,subprocess,sys,tempfile
+binary=pathlib.Path(sys.argv[1]); root=pathlib.Path(tempfile.mkdtemp(prefix='cli-',dir=sys.argv[2]))
+(root/'input/sub').mkdir(parents=True)
+(root/'src.pass').write_text('source-review-key\n');(root/'dst.pass').write_text('destination-review-key\n')
+(root/'input/alpha').write_bytes(b'cross-key backup\n'*1000)
+(root/'input/sub/beta').write_bytes(bytes(range(256))*40)
+os.symlink('../alpha',root/'input/sub/link')
+records=[]
+def call(repo,*args,expected=0):
+ cmd=[str(binary),'--no-cache','-r',str(root/repo),'-p',str(root/('src.pass' if repo=='src' else 'dst.pass')),*map(str,args)]
+ p=subprocess.run(cmd,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
+ records.append({'command':cmd,'exitCode':p.returncode,'output':p.stdout})
+ print('CLI',json.dumps(list(map(str,args))),'EXIT',p.returncode,flush=True);print(p.stdout,flush=True)
+ assert p.returncode==expected,(cmd,p.stdout)
+ return p.stdout
+for repo in ['src','dst']:call(repo,'init')
+call('src','backup','--tag','selected',root/'input')
+call('src','backup','--tag','excluded',root/'input')
+copy=['copy','--from-repo',root/'src','--from-password-file',root/'src.pass','--tag','selected']
+fresh=call('dst',*copy,'--verify');assert 'verified 1 snapshots' in fresh
+skip=call('dst',*copy,'--verify');assert 'verified 1 snapshots' in skip
+sn=json.loads(call('dst','snapshots','--json'));assert len(sn)==1
+call('dst','check','--read-data')
+call('dst','restore','latest','--target',root/'restore')
+for p in (root/'input').rglob('*'):
+ target=root/'restore'/p.relative_to('/')
+ if p.is_symlink():assert os.readlink(p)==os.readlink(target)
+ elif p.is_file():assert hashlib.sha256(p.read_bytes()).digest()==hashlib.sha256(target.read_bytes()).digest()
+print('RESTORE_BYTE_AND_SYMLINK_COMPARISON PASS',flush=True)
+# Default copy retains filtering and skip; no verification output is emitted.
+normal=call('dst',*copy);assert 'verified' not in normal
+assert len(json.loads(call('dst','snapshots','--json')))==1
+call('dst','copy','--from-repo',root/'src','--from-password-file',root/'src.pass','--verify','not-a-snapshot',expected=1)
+assert not list((root/'src/locks').iterdir()) and not list((root/'dst/locks').iterdir())
+# Damage a real encrypted pack. The index still names it, so verify must read it.
+packs=[p for p in (root/'dst/data').rglob('*') if p.is_file()]
+pack=packs[0];pack.chmod(0o600);raw=bytearray(pack.read_bytes());raw[len(raw)//2]^=0xff;pack.write_bytes(raw)
+bad=call('dst',*copy,'--verify',expected=1)
+assert 'snapshot' in bad and 'path' in bad and 'verified' not in bad
+assert not list((root/'src/locks').iterdir()) and not list((root/'dst/locks').iterdir())
+print('CLI_LOCKS source=0 destination=0; CORRUPT_ENCRYPTED_PACK_REJECTED PASS',flush=True)
+out=pathlib.Path(__file__).parent
+(out/'cli-result.json').write_text(json.dumps({'records':records,'restoreCompared':True,'locksReleased':True},ensure_ascii=False,indent=2)+'\n')
diff --git a/evidence/review/verify-offline.py b/evidence/review/verify-offline.py
new file mode 100644
index 000000000..8dd454120
--- /dev/null
+++ b/evidence/review/verify-offline.py
@@ -0,0 +1,55 @@
+import datetime, hashlib, json, os, pathlib, socket, subprocess, sys, tarfile, tempfile
+
+repo = pathlib.Path(__file__).resolve().parents[2]
+out = repo / 'evidence/review'
+materials = repo.parent / 'authoring/offline-materials'
+if len(sys.argv) == 1:
+    manifest = json.loads((materials / 'manifest.json').read_text())
+    for item in manifest:
+        assert hashlib.sha256((materials / item['file']).read_bytes()).hexdigest() == item['sha256'], item['file']
+    run = pathlib.Path(tempfile.mkdtemp(prefix='restic-review-'))
+    run.chmod(0o755)
+    with tarfile.open(materials / 'go1.26.10-linux-amd64.tar.gz') as tf:
+        tf.extractall(run, filter='data')
+    with (out / 'runtime.log').open('w') as log:
+        p = subprocess.run(['unshare', '-n', 'python3', str(pathlib.Path(__file__).resolve()), str(run)], stdout=log, stderr=subprocess.STDOUT)
+    print(json.dumps({'exitCode': p.returncode, 'run': str(run), 'log': str(out/'runtime.log')}))
+    sys.exit(p.returncode)
+
+run = pathlib.Path(sys.argv[1])
+for name in ['modcache', 'buildcache', 'home', 'tmp', 'runtime-cache']:
+    p = run / name
+    p.mkdir(exist_ok=True)
+    os.chown(p, 65534, 65534)
+env = dict(os.environ, HOME=str(run/'home'), GOTOOLCHAIN='local', GOWORK='off', GOMAXPROCS='4',
+    GOMODCACHE=str(run/'modcache'), GOCACHE=str(run/'buildcache'), GOPROXY=materials.joinpath('proxy').as_uri(),
+    GOSUMDB='off', CGO_ENABLED='0', RESTIC_CACHE_DIR=str(run/'runtime-cache'), TMPDIR=str(run/'tmp'))
+go = str(run/'go/bin/go')
+results = []
+def demote():
+    os.setgroups([])
+    os.setgid(65534)
+    os.setuid(65534)
+def command(args, expected=0, uid=True):
+    args = list(map(str, args))
+    print('COMMAND', json.dumps(args), 'UID', 65534 if uid else 0, flush=True)
+    p = subprocess.run(args, cwd=repo, env=env, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, preexec_fn=demote if uid else None)
+    print(p.stdout, flush=True)
+    print('EXIT', p.returncode, flush=True)
+    results.append({'command': args, 'exitCode': p.returncode, 'output': p.stdout})
+    if expected is not None:
+        assert p.returncode == expected
+    return p
+print('MANIFEST_VERIFIED', len(json.loads((materials/'manifest.json').read_text())), flush=True)
+print('ENVIRONMENT', json.dumps({k:env[k] for k in ['HOME','GOMODCACHE','GOCACHE','GOPROXY','RESTIC_CACHE_DIR','CGO_ENABLED']}), flush=True)
+command([sys.executable, '-c', "import socket,os;print('UID',os.getuid());socket.create_connection(('1.1.1.1',443),timeout=1)"], expected=1)
+command([go, 'version'])
+if len(sys.argv)==2:
+    command([go, 'test', './cmd/restic', '-run', '^(TestCopy|TestFindDestinationSnapshot$|TestCompareNodes$|TestVerifyTreeDetectsTamperedBlobs$)', '-count=1', '-v'])
+    overlay = run/'overlay.json'
+    overlay.write_text(json.dumps({'Replace': {str(repo/'cmd/restic/review_contract_test.go'):str(out/'review_contract_test.go.txt')}}))
+    command([go, 'test', '-overlay='+str(overlay), './cmd/restic', '-run', '^TestReview', '-count=3', '-v'])
+    command([go, 'build', '-buildvcs=false', '-o', run/'tmp/restic', './cmd/restic'])
+command([sys.executable,out/'verify-cli.py',run/'tmp/restic',run/'tmp'])
+(out/'runtime-result.json').write_text(json.dumps({'run':str(run),'materials':str(materials),'results':results}, ensure_ascii=False, indent=2)+'\n')
+print('OFFLINE_REVIEW_INITIAL_COMPLETED', flush=True)
